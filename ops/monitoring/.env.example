# =====================================================
# Pro-Diab HIS — ops/monitoring/.env.example
# Copy thanh ops/monitoring/.env, dien gia tri that. KHONG commit .env.
# =====================================================

# Mat khau admin Grafana — BAT BUOC doi khi deploy that (dev co the giu mac dinh trong docker-compose.yml)
GF_ADMIN_PASSWORD=doi_mat_khau_nay

# Domain/URL that Grafana phuc vu (dung khi dat sau reverse proxy, anh huong link tuyet doi trong email alert...)
GF_ROOT_URL=http://localhost:3100

# Ten network Docker cua STACK APP muon monitor (Promtail se join network nay de doc container log
# qua Docker socket). Xem network "name:" trong file compose tuong ung:
#   - ops/docker-compose.yml (dev)          -> prodiab-net
#   - ops/docker-compose.prod.yml (prod)    -> prodiab-prod-net
#   - ops/docker-compose.deploy.yml (deploy)-> prodiab-his-net
PRODIAB_NETWORK=prodiab-net

# SMTP cho Grafana alerting (tuy chon, de trong neu chua can canh bao qua email)
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM=
