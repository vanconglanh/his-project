# =====================================================
# Pro-Diab HIS — ops/monitoring/.env.example
# Copy thanh ops/monitoring/.env, dien gia tri that. KHONG commit .env.
# =====================================================

# Mat khau admin Grafana — BAT BUOC doi khi deploy that (dev co the giu mac dinh trong docker-compose.yml)
GF_ADMIN_PASSWORD=doi_mat_khau_nay

# Domain/URL that Grafana phuc vu (dung khi dat sau reverse proxy, anh huong link tuyet doi trong email alert...)
GF_ROOT_URL=http://localhost:3100

# Ten network Docker cua STACK APP muon monitor (Promtail se join network nay de doc container log
# qua Docker socket). Xem network "name:" trong file compose tuong ung:
#   - ops/docker-compose.yml (dev)          -> prodiab-net
#   - ops/docker-compose.prod.yml (prod)    -> prodiab-prod-net
#   - ops/docker-compose.deploy.yml (deploy)-> prodiab-his-net
PRODIAB_NETWORK=prodiab-net

# SMTP cho Grafana alerting (tuy chon, de trong neu chua can canh bao qua email)
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM=

# =====================================================
# SMTP cho Alertmanager (BO tu dien khi trien khai that — container van chay on
# dinh, KHONG crash-loop, neu de trong/gia tri mac dinh nhu duoi day; nhung se
# KHONG gui duoc email that cho toi khi dien dung SMTP that).
# Dien xong CHI CAN "docker compose up -d" lai — KHONG can sua bat ky file .yml
# nao (alertmanager-config.template.yml duoc service "alertmanager-config" tu
# render lai bien moi truong).
# =====================================================
# Host SMTP (KHONG kem port — port khai bao rieng o SMTP_PORT)
SMTP_HOST=smtp.gmail.com
# Port SMTP: 587 (STARTTLS, pho bien nhat), 465 (SSL/TLS), 25 (khong ma hoa, hiem dung)
SMTP_PORT=587
# Dia chi hien thi trong truong "From" cua email canh bao
SMTP_FROM=prodiab-alert@example.com
# Tai khoan dang nhap SMTP (vd Gmail: dung App Password, KHONG dung mat khau tai khoan chinh)
SMTP_USER=
# Mat khau / App Password SMTP — KHONG commit gia tri that vao git
SMTP_PASSWORD=
# true/false — Gmail va hau het SMTP that YEU CAU true. Chi dat false khi test
# qua MailHog cuc bo (MailHog khong ho tro TLS).
SMTP_REQUIRE_TLS=true
# Email(s) nhan canh bao van hanh (5xx cao, disk day, DB down...). Nhieu nguoi
# nhan dung dau phay: "a@x.com,b@x.com" KHONG duoc ho tro truc tiep o day —
# Alertmanager email_configs chi nhan 1 dia chi "to"; can nhieu nguoi nhan thi
# dung mailing list/group email cua don vi.
OPS_ALERT_EMAIL=devops@example.com

# Webhook Slack / PagerDuty (tuy chon — de gia tri CHANGE_ME neu chua dung kenh nay)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
SLACK_WEBHOOK_SECURITY=https://hooks.slack.com/services/CHANGE_ME
PAGERDUTY_INTEGRATION_KEY=CHANGE_ME
