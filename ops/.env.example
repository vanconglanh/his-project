# --- Ma hoa PII (Hang muc 6) ---
# Sinh khoa: openssl rand -base64 32  (moi moi truong mot khoa rieng, KHONG commit gia tri that)
ENCRYPTION_MASTER_KEY=
# Khoa RIENG cho blind index (HMAC-SHA256) — BAT BUOC khac ENCRYPTION_MASTER_KEY.
# Thieu khoa nay: tra cuu benh nhan theo SDT / CMND / so the BHYT se khong hoat dong.
ENCRYPTION_BLIND_INDEX_KEY=

# --- Sentry ---
