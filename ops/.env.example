# =====================================================
# Pro-Diab HIS — .env.example
# Copy file nay thanh .env va dien gia tri thuc
# KHONG commit .env vao repo
# =====================================================

# --- MySQL ---
DB_ROOT_PASSWORD=root_dev
DB_NAME=prodiab_his
DB_USER=prodiab
DB_PASSWORD=prodiab_dev_2026

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_2026

# --- JWT ---
JWT_SECRET=dev_secret_min_32_chars_xxxxxxxxxx
JWT_ISSUER=ProDiabHis
JWT_AUDIENCE=ProDiabHis.Clients

# --- Sentry ---
SENTRY_DSN=

# --- SMTP (dev dung MailHog) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# --- App ---
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000

# APP_PUBLIC_URL: dung cho docker-compose.deploy.yml — vua la NEXT_PUBLIC_API_BASE_URL
# (bake vao build frontend, KHONG doi duoc sau khi build image) vua la
# CorsHardening__AllowedOrigins__0 (backend). BAT BUOC dat dung domain PUBLIC THAT ma
# nguoi dung truy cap (vd "https://his.diab.com.vn"), KHONG duoc dung IP:port truc tiep
# hay "http://" khi da co domain HTTPS — trinh duyet se chan MOI goi API la "Mixed Content"
# (trang HTTPS goi API HTTP) khien toan bo app (dashboard, form Tao/Sua...) khong hoat dong
# du UI van render binh thuong (loi im lang, chi thay trong console). Neu doi domain/scheme
# sau khi da deploy, PHAI rebuild lai frontend (--build frontend), restart khong du.
APP_PUBLIC_URL=http://localhost:3000

# NEXT_PUBLIC_BASE_DOMAIN: domain goc de FE ghep subdomain phong kham o man quan ly tenant
# (hien thi "<subdomain>.${NEXT_PUBLIC_BASE_DOMAIN}"). Production/staging dung domain that
# "diab.com.vn" (xem ops/nginx/deploy-prodiab.conf, portal-client/DEPLOY.md muc 4b).
# Dev/local co the de trong — code fallback "prodiab.vn" (frontend/lib/utils/constants.ts).
NEXT_PUBLIC_BASE_DOMAIN=diab.com.vn
