# =====================================================
# Pro-Diab HIS — .env.example
# Copy file nay thanh .env va dien gia tri thuc
# KHONG commit .env vao repo
# =====================================================

# --- MySQL ---
DB_ROOT_PASSWORD=root_dev
DB_NAME=prodiab_his
DB_USER=prodiab
DB_PASSWORD=prodiab_dev_2026

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_2026
# Host/domain MinIO ma TRINH DUYET nguoi dung truy cap duoc (dung khi sinh presigned URL tra ve FE).
# KHAC voi Minio__Endpoint noi bo ("minio:9000", chi resolve duoc trong docker network) — GIU NGUYEN
# Minio__Endpoint, chi cau hinh bien nay them.
# - Local dev (ops/docker-compose.local-app.yml): mac dinh "localhost:9000" (MinIO da publish port 9000 ra host).
# - Staging/Production: BAT BUOC dien domain/IP that ma nguoi dung truy cap duoc (vd "files.example.com"
#   hoac IP public:9000 neu da mo firewall) — KHONG bo trong o prod, khong co gia tri mac dinh an toan.
MINIO_PUBLIC_ENDPOINT=
# true neu MinIO public endpoint phuc vu qua HTTPS (vd sau reverse proxy/CDN co TLS)
MINIO_PUBLIC_USE_SSL=false

# --- JWT ---
JWT_SECRET=dev_secret_min_32_chars_xxxxxxxxxx
JWT_ISSUER=ProDiabHis
JWT_AUDIENCE=ProDiabHis.Clients

# --- Ma hoa PII (Hang muc 6) ---
# Sinh khoa: openssl rand -base64 32  (moi moi truong mot khoa rieng, KHONG commit gia tri that)
ENCRYPTION_MASTER_KEY=
# Khoa RIENG cho blind index (HMAC-SHA256) — BAT BUOC khac ENCRYPTION_MASTER_KEY.
# Thieu khoa nay: tra cuu benh nhan theo SDT / CMND / so the BHYT se khong hoat dong.
ENCRYPTION_BLIND_INDEX_KEY=

# --- Bao mat / 2FA ---
# Danh sach role_code bat buoc 2FA, phan cach dau phay. Mac dinh (khong set bien
# nay) = "admin" theo appsettings.json. CHI de rong "" tren moi truong TEST/DEMO
# de tam tat bat buoc 2FA khi test nhanh - KHONG de rong tren production that.
SECURITY_MANDATORY_MFA_ROLES=admin

# --- Sentry ---
SENTRY_DSN=

# --- SMTP (dev dung MailHog) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# --- App ---
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
