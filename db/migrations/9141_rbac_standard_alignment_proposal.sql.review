--  WHERE rp.role_id = @duocsi AND p.code = 'report.build';

-- ---------------------------------------------------------------------------
-- B4. [P3-09] Thu hồi quyền thu tiền gói của LỄ TÂN (loại trừ với A3).
--     Chỉ chạy nếu chủ phòng khám xác nhận CHỈ kế toán được thu tiền.
