--
-- !!! ĐÂY LÀ ĐỀ XUẤT — CHƯA ÁP DỤNG !!!
-- Đuôi file .review để migrator KHÔNG tự động chạy.
-- Chỉ đổi tên thành 9141_rbac_standard_alignment.sql khi leader đã duyệt.
--
-- Căn cứ: docs/prd/rbac-doi-chieu-chuan-20260829.md
-- Mục tiêu: khắc phục các điểm lệch nguyên tắc segregation of duties (SoD)
--           và least privilege phát hiện khi đối chiếu migration 9139 với
--           TT 13/2025/TT-BYT, Luật KCB 2023 Đ.69, Luật BVDLCN 2025 (NĐ 356/2025).
--
-- CẤU TRÚC: 3 phần, ĐỘC LẬP nhau, có thể áp từng phần.
--   PHẦN A — chỉ THÊM quyền, rủi ro regression = 0  → khuyến nghị áp ngay
--   PHẦN B — THU HỒI quyền, cần xác nhận nghiệp vụ  → mặc định bị comment
--   PHẦN C — mã quyền mới cho tính năng chưa có code → mặc định bị comment
--
-- Idempotent: dùng INSERT IGNORE / DELETE theo code. Chạy lại nhiều lần an toàn.
-- =============================================================================

SET @admin  = '00000000-0000-0000-0000-000000000001';
SET @bacsi  = '00000000-0000-0000-0000-000000000002';
SET @letan  = '00000000-0000-0000-0000-000000000003';
SET @duocsi = '00000000-0000-0000-0000-000000000004';
SET @ketoan = '00000000-0000-0000-0000-000000000005';
SET @ktv    = '00000000-0000-0000-0000-000000000006';


-- =============================================================================
-- PHẦN A — CHỈ THÊM QUYỀN (an toàn, khuyến nghị áp dụng ngay)
-- =============================================================================

-- ---------------------------------------------------------------------------
-- A1. [P1-02] Kế toán phải nhìn thấy và chốt được vòng CLS.
--     Hiện tại ke_toan KHÔNG có bất kỳ mã cls_round.* nào => không thể thu tiền
--     CLS đúng quy trình, buộc bác sĩ phải tự bấm PAID (vi phạm SoD).
--     Cấp quyền này là ĐIỀU KIỆN TIÊN QUYẾT để sau đó thu hồi được của bác sĩ (B1).
-- ---------------------------------------------------------------------------
INSERT IGNORE INTO diab_his_sec_role_permissions (role_id, permission_id)
SELECT @ketoan, id FROM diab_his_sec_permissions WHERE code IN (
  'cls_round.read',
  'cls_round.pay',
  'cls_round.waive'
);

-- ---------------------------------------------------------------------------
-- A2. [P1-03] Bác sĩ phải duyệt được kết quả CLS.
--     Hiện tại chỉ ky_thuat_vien có *.verify => KTV tự nhập rồi tự duyệt kết quả
--     của chính mình (LabResultHandlers.cs không so sánh VerifiedBy vs PerformedBy).
--     Cấp verify cho bác sĩ để luôn tồn tại "mắt thứ hai" có chuyên môn.
-- ---------------------------------------------------------------------------
INSERT IGNORE INTO diab_his_sec_role_permissions (role_id, permission_id)
SELECT @bacsi, id FROM diab_his_sec_permissions WHERE code IN (
  'lab_result.verify',
  'rad_result.verify'
);

-- ---------------------------------------------------------------------------
-- A3. [P3-09] Nếu nghiệp vụ cho phép lễ tân thu tiền gói dịch vụ
--     (le_tan đang có package_subscription.collect + billing.create) thì tiền
--     phải nằm trong một ca quỹ, nếu không sẽ không đối soát được cuối ngày.
--     >>> BỎ COMMENT nếu chủ phòng khám xác nhận lễ tân ĐƯỢC thu tiền.
--     >>> Nếu KHÔNG, xem mục B4 để thu hồi quyền thu tiền của lễ tân.
-- ---------------------------------------------------------------------------
-- INSERT IGNORE INTO diab_his_sec_role_permissions (role_id, permission_id)
